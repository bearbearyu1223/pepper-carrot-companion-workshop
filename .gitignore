# Environment
.env
.env.local
.env.*.local
# .env.production* is for the Fly deploy (Post 10/11) — never commit it
# (covers .env.production, .env.production.modal, .env.production.*.bak, etc).
# The only committed templates are the two .example files, un-ignored below.
.env.production
.env.production.*
!.env.production.example
!.env.production.anthropic.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# uv — keep the lockfile committed (this is an app, not a library)
.python-version

# Data — local images, Postgres bind mount, downloaded episodes
data/postgres/
data/images/
data/raw/ep*/
data/chroma/

# Post 10 — the Fly Docker build bakes data/seed.sql produced by
# infra/dump_seed.sh. The dump is generated from local Postgres and rebuilt
# on every redeploy; never commit it.
data/seed.sql

# World-graph: the YAML pair + image manifest ARE committed (small, durable,
# version-controlled). The scraped image bytes are NOT — anyone can re-run
# `ingestion/wiki_image_scraper.py` to pull them back from framagit.
data/world-graph/images/

# OS
.DS_Store
Thumbs.db

# Frontend (Node)
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Editor
.idea/
.vscode/
*.swp
