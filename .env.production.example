# .env.production — copy to .env.production and fill in.
#
# Every value below maps to either a Fly secret (`fly secrets set NAME=VALUE`)
# or a Cloudflare Pages build-time env var. See docs/deployment.md for the
# step-by-step that produces each one.
#
# This file is gitignored. The committed example carries placeholders only.

# ─── Postgres on Neon ─────────────────────────────────────────────────────────
# Two endpoints — Neon shows both in Connection Details (toggle pooled/unpooled).
#
# UNPOOLED is for the FastAPI backend, which uses asyncpg. asyncpg uses
# prepared statements; pgbouncer in transaction mode (the pooled endpoint)
# hands each query to a different backend that has never seen the prepared
# statement, and asyncpg errors out. The unpooled endpoint connects directly.
#
# POOLED is for psql, used by infra/entrypoint.sh during the one-shot seed
# restore on first boot. psql doesn't use prepared statements; the pooler
# is fine for it.

# Used by infra/entrypoint.sh at first-boot seed restore. libpq scheme.
POSTGRES_RESTORE_URL=postgresql://neondb_owner:PASS@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Used by the backend at runtime. SQLAlchemy + asyncpg scheme.
DATABASE_URL_OVERRIDE=postgresql+asyncpg://neondb_owner:PASS@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require

# ─── Ollama on Modal ──────────────────────────────────────────────────────────
# OLLAMA_BASE_URL is the URL Modal prints when `modal deploy infra/modal_ollama.py`
# completes. The proxy-auth tokens are generated separately in the Modal
# dashboard (Settings → Proxy Auth Tokens → Create); both must be set together.
#
# This is the default path. If you'd rather skip Modal entirely (zero cold start,
# ~$0.10/mo total — at the cost of giving up self-hosted/private inference),
# comment these out and use the "Alternative" block at the bottom of this file.
OLLAMA_BASE_URL=https://your-workspace--peppercarrot-ollama-serve.modal.run
MODAL_PROXY_TOKEN_ID=wk-...
MODAL_PROXY_TOKEN_SECRET=ws-...

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
# Account ID is shown on the R2 dashboard (right sidebar, 32-char hex).
# Access key + secret come from R2 → Manage API Tokens → Create API token
# (Object Read & Write, scoped to your bucket).
R2_ACCOUNT_ID=00000000000000000000000000000000
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=peppercarrot-images

# R2_PUBLIC_URL_PREFIX is the public read prefix for the bucket:
#   - R2.dev subdomain (free):   https://pub-XXXXXXXXXXXX.r2.dev
#   - Custom domain:             https://images.your-domain.com
# No trailing slash. The backend's R2Storage.url_for() composes
# `{prefix}/{key}` so this needs to point at the bucket root.
R2_PUBLIC_URL_PREFIX=https://pub-XXXXXXXXXXXX.r2.dev

# ─── CORS ─────────────────────────────────────────────────────────────────────
# The Cloudflare Pages URL the frontend is served from. Must match exactly —
# scheme included, no trailing slash. JSON array; pydantic parses it.
CORS_ORIGINS=["https://your-app.pages.dev"]

# ─── Build-time only (Cloudflare Pages, not Fly) ──────────────────────────────
# Vite inlines this at build time, so the frontend's compiled JS calls your
# Fly backend directly. Without it, the frontend would call localhost:8000.
# Set this in Cloudflare Pages → Settings → Environment variables (Build).
VITE_API_BASE_URL=https://peppercarrot-companion.fly.dev

# ─── Alternative: skip Modal entirely (Anthropic + Voyage AI) ─────────────────
# If you'd rather not run a Modal GPU — zero cold start, ~$0.10/mo for the
# chat layer instead of ~$5–10, at the cost of giving up self-hosted /
# private inference and re-indexing Chroma (Voyage's vectors live in a
# different space than bge-m3's) — uncomment the block below AND:
#   1. Comment out OLLAMA_BASE_URL + MODAL_PROXY_TOKEN_* above.
#   2. Skip Step 1 of docs/deployment.md (the `modal deploy ...` step).
#   3. Re-run `ingestion/ingest.py` + `ingest_wiki.py` against your local
#      DB with EMBEDDING_PROVIDER=voyage so Chroma rebuilds with Voyage
#      vectors, then `./infra/dump_seed.sh && fly deploy`.
# The cost/latency/privacy trade-off is documented in §7 of Post 10.
#
# CHAT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5
#
# EMBEDDING_PROVIDER=voyage
# VOYAGE_API_KEY=pa-...
# VOYAGE_MODEL=voyage-3-lite
