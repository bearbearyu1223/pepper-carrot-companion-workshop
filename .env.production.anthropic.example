# .env.production (Anthropic + Voyage path) — copy to .env.production and fill in.
#
# This is the ALTERNATIVE deploy path: skip Modal entirely. Chat runs on the
# Anthropic Messages API; embeddings run on the Voyage AI HTTP API. No GPU to
# operate, zero cold start on the first answer, ~$0.10/mo for the chat layer
# instead of ~$5–10. The trade-off is that prompts and embed-queries leave your
# infra, and you give up the series' local-first thesis. See
# docs/deployment-anthropic.md for the full walkthrough and
# docs/decisions/0005-managed-api-alternative.md for the why.
#
# Every value below maps to either a Fly secret (`fly secrets set NAME=VALUE`)
# or a Cloudflare Pages build-time env var. This file is gitignored; the
# committed example carries placeholders only.
#
# IMPORTANT — fly.toml carries an [env] block that pins CHAT_PROVIDER='ollama'
# and EMBEDDING_PROVIDER='ollama' for the default path. For THIS path you flip
# both to anthropic/voyage. Fly secrets override fly.toml [env] values of the
# same name, so the two CHAT_PROVIDER/EMBEDDING_PROVIDER lines below will win —
# but the cleaner move is to edit fly.toml's [env] directly (these are config,
# not secrets). docs/deployment-anthropic.md Step 6 does exactly that.

# ─── Provider selection ───────────────────────────────────────────────────────
# These pick the chat + embedding implementations in backend/app/clients/.
# STORAGE_BACKEND stays 'r2' — image storage is not coupled to the chat layer.
CHAT_PROVIDER=anthropic
EMBEDDING_PROVIDER=voyage
STORAGE_BACKEND=r2

# ─── Anthropic (chat) ─────────────────────────────────────────────────────────
# Key from https://console.anthropic.com → Settings → API Keys → Create Key.
# claude-haiku-4-5 is the cheapest current model and is plenty for grounded,
# retrieval-backed answers; step up to claude-sonnet-4-6 if you want more
# polish at ~10× the per-token cost.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# ─── Voyage AI (embeddings) ───────────────────────────────────────────────────
# Key from https://dashboard.voyageai.com → API Keys. voyage-4-lite is the
# cheapest current model (1024-dim default, ~$0.02/M tokens, 200M free tokens)
# and adequate for retrieval at portfolio scale; voyage-4 / voyage-4-large are
# quality step-ups at higher cost.
#
# NOTE: Voyage's vectors live in a DIFFERENT space than bge-m3's, so the local
# Chroma collections (pages_v1, wiki_v1) MUST be rebuilt with Voyage before
# deploy — see docs/deployment-anthropic.md Step 2. This holds even though
# voyage-4-lite and bge-m3 are BOTH 1024-dim: same length, different space.
# Postgres + R2 stay put.
VOYAGE_API_KEY=pa-...
VOYAGE_MODEL=voyage-4-lite

# ─── Postgres on Neon ─────────────────────────────────────────────────────────
# Two endpoints — Neon shows both in Connection Details (toggle pooled/unpooled).
#
# UNPOOLED is for the FastAPI backend, which uses asyncpg. asyncpg uses
# prepared statements; pgbouncer in transaction mode (the pooled endpoint)
# hands each query to a different backend that has never seen the prepared
# statement, and asyncpg errors out. The unpooled endpoint connects directly.
#
# POOLED is for psql, used by infra/entrypoint.sh during the one-shot seed
# restore on first boot. psql doesn't use prepared statements; the pooler is
# fine for it.

# Used by infra/entrypoint.sh at first-boot seed restore. libpq scheme.
POSTGRES_RESTORE_URL=postgresql://neondb_owner:PASS@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Used by the backend at runtime. SQLAlchemy + asyncpg scheme.
DATABASE_URL_OVERRIDE=postgresql+asyncpg://neondb_owner:PASS@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
# Account ID is shown on the R2 dashboard (right sidebar, 32-char hex).
# Access key + secret come from R2 → Manage API Tokens → Create API token
# (Object Read & Write, scoped to your bucket). Identical to the default path.
R2_ACCOUNT_ID=00000000000000000000000000000000
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=peppercarrot-images

# R2_PUBLIC_URL_PREFIX is the public read prefix for the bucket:
#   - R2.dev subdomain (free):   https://pub-XXXXXXXXXXXX.r2.dev
#   - Custom domain:             https://images.your-domain.com
# No trailing slash. The backend's R2Storage.url_for() composes
# `{prefix}/{key}` so this needs to point at the bucket root.
R2_PUBLIC_URL_PREFIX=https://pub-XXXXXXXXXXXX.r2.dev

# ─── CORS ─────────────────────────────────────────────────────────────────────
# The Cloudflare Pages URL the frontend is served from. Must match exactly —
# scheme included, no trailing slash. JSON array; pydantic-settings JSON-decodes
# it. The SINGLE QUOTES around the value are load-bearing: the deploy guide does
# `set -a && source .env.production && set +a && fly secrets set …`, and without
# the single quotes bash strips the inner double quotes while sourcing, leaving
# `[https://your-app.pages.dev]` — invalid JSON, which crashes the app on
# startup with `error parsing value for field "cors_origins"`.
# Multiple origins: '["https://your-app.pages.dev","https://www.your-domain.com"]'
CORS_ORIGINS='["https://your-app.pages.dev"]'

# ─── Build-time only (Cloudflare Pages, not Fly) ──────────────────────────────
# Vite inlines this at build time, so the frontend's compiled JS calls your
# Fly backend directly. Without it, the frontend would call localhost:8000.
# Set this in Cloudflare Pages → Settings → Environment variables (Build).
VITE_API_BASE_URL=https://pepper-carrot-ai-flipbook-workshop.fly.dev
